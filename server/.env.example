# ─── Auth0 ────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
# API Identifier configured in Auth0 Dashboard → APIs
AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/

# Auth0 Token Vault
# The Token Vault endpoint is at: https://{domain}/api/v2/user-vault/tokens
# Tokens are fetched server-side using a Management API token
AUTH0_MGMT_TOKEN=your_management_api_token
# Optional (server-only) machine-to-machine credentials used to mint MGMT token.
# Do NOT use SPA application credentials here.
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret
# Optional: exact Auth0 connection names (if custom-named in dashboard)
# Defaults are slack / notion / discord when not set
AUTH0_CONNECTION_SLACK=slack
AUTH0_CONNECTION_NOTION=notion
AUTH0_CONNECTION_DISCORD=discord
# Optional: verbose vault debug logs (safe token previews only)
AUTH0_VAULT_DEBUG=false

# ─── OpenRouter (Supports Claude, GPT, and other models) ───
# Sign up at https://openrouter.ai and generate an API key
OPENROUTER_API_KEY=sk-or-

# ─── Slack (registered as Auth0 social connection) ─
# These are used when setting up the Auth0 connection,
# not called directly — Token Vault handles the OAuth tokens.
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_TOKEN=your_slack_app_level_token

# ─── Notion (registered as Auth0 social connection) ─
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

# ─── Discord (registered as Auth0 social connection) ─
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ─── App ──────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development
