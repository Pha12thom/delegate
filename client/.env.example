VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# Must be the Client ID of an Auth0 "Single Page Application" (not M2M)
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/
VITE_API_URL=http://localhost:3001
VITE_AUTH0_CONNECTION_SLACK=sign-in-with-slack
VITE_AUTH0_CONNECTION_NOTION=notion
VITE_AUTH0_CONNECTION_DISCORD=discord
